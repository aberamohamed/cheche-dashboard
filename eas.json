{
    "cli": {
      "version": ">= 16.0.1",
      "appVersionSource": "remote"
    },
    "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "ios": {
          "simulator": true
        }
      },
      "preview": {
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "ios": {
          "simulator": false
        }
      },
      "production": {
        "autoIncrement": true,
        "android": {
          "buildType": "app-bundle"
        },
        "ios": {}
      }
    },
    "submit": {
      "production": {
        "android": {
          "track": "production"
        },
        "ios": {
          "appleId": "abera@cheche.et",
          "ascAppId": "6757654939",
          "appleTeamId": "KWD9X423AW"
        }
      }
    }
  }
  