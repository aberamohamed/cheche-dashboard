{
  "expo": {
    "name": "Cheche POS",
    "slug": "cheche-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chechepos",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.cheche.pos",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Cheche POS uses the camera to scan product barcodes.",
        "NSFaceIDUsageDescription": "Cheche POS uses Face ID for secure login.",
        "NSPhotoLibraryUsageDescription": "Cheche POS uses your photo library to upload profile and product images.",
        "NSLocationWhenInUseUsageDescription": "Cheche POS uses GPS time for accurate offline sale timestamps on receipts."
      }
    },
    "android": {
      "icon": "./assets/images/adaptive_icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#E30074",
        "foregroundImage": "./assets/images/adaptive_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cheche.pos",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/cheche_pos.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/cheche_pos_splash_android.png",
            "imageWidth": 305
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cheche POS to access your camera for barcode scanning.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cheche POS uses GPS time for accurate offline sale timestamps on receipts."
        }
      ],
      "./plugins/withBluetoothNeverForLocation.js",
      "expo-sqlite",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d996f735-57b0-4dbf-8a10-8c6d2efedacd"
      }
    },
    "owner": "abcheche"
  }
}
